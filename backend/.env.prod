# Configuration de Production - LireLibre

# Variables d'environnement pour la production
APP_ENV=prod
APP_SECRET=votre_secret_de_production_tres_secure
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# Configuration JWT pour la production
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=votre_passphrase_jwt_secure

# Configuration CORS pour la production (ajustez selon votre domaine)
CORS_ALLOW_ORIGIN=https://votre-domaine.com

# Configuration base de données pour la production
# Décommentez et configurez selon votre base de données de production
# DATABASE_URL="mysql://user:password@127.0.0.1:3306/lirelibre_prod?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="postgresql://user:password@127.0.0.1:5432/lirelibre_prod?serverVersion=15&charset=utf8"
