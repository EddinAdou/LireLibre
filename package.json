{
  "name": "lirelibre",
  "version": "0.1.0",
  "description": "Plateforme collaborative d'écriture et de lecture d'histoires",
  "private": true,
  "scripts": {
    "dev": "docker-compose -f docker/docker-compose.yml up -d",
    "dev:build": "docker-compose -f docker/docker-compose.yml up -d --build",
    "stop": "docker-compose -f docker/docker-compose.yml down",
    "logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release": "node scripts/release.js",
    "pr:create": "node scripts/auto-pr.js",
    "pr:check": "node scripts/pre-push-check.js",
    "pipeline:status": "gh run list --limit 5",
    "pipeline:watch": "gh run watch",
    "quality:check": "npm run quality:frontend && npm run quality:backend",
    "quality:frontend": "cd frontend && npm run lint && npm run build",
    "quality:backend": "cd backend && composer install && vendor/bin/phpcs --standard=PSR12 src/",
    "security:audit": "npm run security:frontend && npm run security:backend",
    "security:frontend": "cd frontend && npm audit",
    "security:backend": "cd backend && composer audit",
    "setup:hooks": "bash scripts/setup-hooks.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EddinAdou/LireLibre.git"
  },
  "keywords": [
    "collaborative-writing",
    "stories",
    "reading-platform",
    "react",
    "symfony",
    "docker"
  ],
  "author": "LireLibre Team",
  "license": "MIT",
  "devDependencies": {
    "conventional-changelog-cli": "^3.0.0",
    "semver": "^7.5.4"
  }
}
