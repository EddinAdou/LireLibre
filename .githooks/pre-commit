#!/bin/sh
# Pre-commit hook pour vérifier les conventions de commit

# Couleurs
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "${YELLOW}🔍 Vérification pre-commit...${NC}"

# Vérifier les fichiers staged
files_changed=$(git diff --cached --name-only)

if [ -z "$files_changed" ]; then
    echo "${RED}❌ Aucun fichier staged pour commit${NC}"
    exit 1
fi

# Vérifier le format des fichiers Frontend (si modifiés)
frontend_files=$(echo "$files_changed" | grep "^frontend/" | grep -E "\.(js|jsx|ts|tsx)$")
if [ ! -z "$frontend_files" ]; then
    echo "${YELLOW}🎨 Vérification du format Frontend...${NC}"
    cd frontend
    npm run lint:check 2>/dev/null || echo "${YELLOW}⚠️  Linting Frontend non configuré${NC}"
    cd ..
fi

# Vérifier les standards PHP Backend (si modifiés)
backend_files=$(echo "$files_changed" | grep "^backend/" | grep "\.php$")
if [ ! -z "$backend_files" ]; then
    echo "${YELLOW}🔧 Vérification du format Backend...${NC}"
    cd backend
    # Vérifier avec PHP CodeSniffer si disponible
    vendor/bin/phpcs --standard=PSR12 src/ 2>/dev/null || echo "${YELLOW}⚠️  PHP CodeSniffer non configuré${NC}"
    cd ..
fi

# Vérifier qu'il n'y a pas de console.log/var_dump oubliés
echo "${YELLOW}🧹 Vérification des debug statements...${NC}"
debug_js=$(git diff --cached | grep -E "^\+.*console\.(log|warn|error|debug)")
debug_php=$(git diff --cached | grep -E "^\+.*(var_dump|print_r|dd\()")

if [ ! -z "$debug_js" ] || [ ! -z "$debug_php" ]; then
    echo "${RED}❌ Debug statements détectés:${NC}"
    [ ! -z "$debug_js" ] && echo "$debug_js"
    [ ! -z "$debug_php" ] && echo "$debug_php"
    echo "${YELLOW}Supprimez les debug statements avant de commiter${NC}"
    exit 1
fi

# Vérifier les secrets/mots de passe
echo "${YELLOW}🔐 Vérification des secrets...${NC}"
secrets=$(git diff --cached | grep -iE "^\+.*(password|secret|key|token).*=.*['\"][^'\"]{8,}")
if [ ! -z "$secrets" ]; then
    echo "${RED}❌ Possibles secrets détectés:${NC}"
    echo "$secrets"
    echo "${YELLOW}Vérifiez qu'aucun secret n'est commité${NC}"
    exit 1
fi

echo "${GREEN}✅ Pre-commit checks passed!${NC}"
exit 0
