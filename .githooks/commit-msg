#!/bin/sh
# Commit-msg hook pour vérifier les conventions de commit

# Couleurs
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

commit_regex='^(feat|fix|docs|style|refactor|test|chore)(\(.+\))?: .{1,50}'

error_msg="❌ Message de commit invalide!

Format requis:
  <type>[optional scope]: <description>

Types valides:
  feat:     Nouvelle fonctionnalité
  fix:      Correction de bug
  docs:     Documentation
  style:    Formatage, style
  refactor: Refactoring
  test:     Tests
  chore:    Maintenance

Exemples:
  feat(auth): add JWT authentication
  fix(stories): resolve pagination bug
  docs: update API documentation"

# Lire le message de commit
commit_message=$(cat "$1")

# Ignorer les commits de merge automatiques
if echo "$commit_message" | grep -qE "^Merge [a-f0-9]+ into [a-f0-9]+"; then
    echo "${YELLOW}⚠️  Commit de merge automatique détecté - validation ignorée${NC}"
    exit 0
fi

# Ignorer les commits de merge avec références de branches
if echo "$commit_message" | grep -qE "^Merge (branch|pull request)"; then
    echo "${YELLOW}⚠️  Commit de merge détecté - validation ignorée${NC}"
    exit 0
fi

if ! echo "$commit_message" | grep -qE "$commit_regex"; then
    echo "${RED}$error_msg${NC}" >&2
    echo "${RED}Message reçu: $commit_message${NC}" >&2
    exit 1
fi

echo "${GREEN}✅ Message de commit valide${NC}"
