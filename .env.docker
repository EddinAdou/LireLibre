# Configuration Docker pour LireLibre
# Ce fichier contient les variables d'environnement pour Docker Compose

# === BASE DE DONNÉES POSTGRESQL ===
POSTGRES_VERSION=15
POSTGRES_DB=lirelibre
POSTGRES_USER=lirelibre
POSTGRES_PASSWORD=lirelibre_password

# === PGADMIN ===
PGADMIN_DEFAULT_EMAIL=admin@lirelibre.fr
PGADMIN_DEFAULT_PASSWORD=admin123

# === BACKEND SYMFONY ===
APP_ENV=dev
APP_SECRET=your-secret-key-change-this-in-production
DATABASE_URL=postgresql://lirelibre:lirelibre_password@database:5432/lirelibre
REDIS_URL=redis://redis:6379
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=your-jwt-passphrase-change-this
CORS_ALLOW_ORIGIN=http://localhost:3000

# === FRONTEND REACT ===
VITE_API_URL=http://localhost:8080/api
NODE_ENV=development

# === REDIS ===
REDIS_PASSWORD=

# === NGINX ===
NGINX_HOST=localhost
NGINX_PORT=8080
